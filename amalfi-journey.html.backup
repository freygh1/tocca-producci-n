    <!-- REQUEST MODAL -->
    <div id="requestModal" class="request-modal" style="display: none; position: fixed; z-index: 9999; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.5);">
        <div class="request-modal-content" style="background-color: #fefefe; margin: 5% auto; padding: 40px; border-radius: 12px; max-width: 900px; position: relative; box-shadow: 0 10px 40px rgba(0,0,0,0.2);">
            <span class="request-modal-close" onclick="closeRequestModal()" style="color: #aaa; float: right; font-size: 32px; font-weight: bold; cursor: pointer; line-height: 20px;">&times;</span>
            <h2 style="font-family: 'Playfair Display', serif; font-size: 2rem; color: #3a3a3a; margin-bottom: 30px; text-align: center;"></h2>
            
            <div class="request-contact-options" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 25px;">
                <div class="request-option" style="background: #f9f9f9; padding: 30px 20px; border-radius: 12px; text-align: center; transition: all 0.3s ease;">
                    <i class="fas fa-envelope" style="font-size: 2.5rem; color: #4A9A92; margin-bottom: 15px;"></i>
                    <h3 style="font-family: 'Montserrat', sans-serif; font-weight: 600; color: #3a3a3a; margin-bottom: 15px; font-size: 1.1rem;">Email Jessica</h3>
                    <a href="mailto:info@toccaamalfi.com?subject=More%20information%20-%20Signature%20Journey" class="request-btn" style="background: #4A9A92; color: white; padding: 12px 24px; border-radius: 6px; text-decoration: none; font-family: 'Montserrat', sans-serif; font-weight: 600; display: inline-block; transition: all 0.3s ease;">Send an Email</a>
                </div>
                
                <div class="request-option" style="background: #f9f9f9; padding: 30px 20px; border-radius: 12px; text-align: center; transition: all 0.3s ease;">
                    <i class="fas fa-phone" style="font-size: 2.5rem; color: #4A9A92; margin-bottom: 15px;"></i>
                    <h3 style="font-family: 'Montserrat', sans-serif; font-weight: 600; color: #3a3a3a; margin-bottom: 15px; font-size: 1.1rem;">Request a Call</h3>
                    <a href="tel:+16462298158" class="request-btn" style="background: #4A9A92; color: white; padding: 12px 24px; border-radius: 6px; text-decoration: none; font-family: 'Montserrat', sans-serif; font-weight: 600; display: inline-block; transition: all 0.3s ease;">Schedule a Call</a>
                </div>
                
                <div class="request-option" style="background: #f9f9f9; padding: 30px 20px; border-radius: 12px; text-align: center; transition: all 0.3s ease;">
                    <i class="fab fa-whatsapp" style="font-size: 2.5rem; color: #25D366; margin-bottom: 15px;"></i>
                    <h3 style="font-family: 'Montserrat', sans-serif; font-weight: 600; color: #3a3a3a; margin-bottom: 15px; font-size: 1.1rem;">WhatsApp</h3>
                    <a href="https://wa.me/16462298158?text=Hello!%20I'd%20like%20to%20know%20more%20about%20the%20Signature%20Journey." target="_blank" class="request-btn" style="background: #25D366; color: white; padding: 12px 24px; border-radius: 6px; text-decoration: none; font-family: 'Montserrat', sans-serif; font-weight: 600; display: inline-block; transition: all 0.3s ease;">Send a Message</a>
                </div>
                
                <div class="request-option" style="background: #f9f9f9; padding: 30px 20px; border-radius: 12px; text-align: center; transition: all 0.3s ease;">
                    <i class="fas fa-comment" style="font-size: 2.5rem; color: #4A9A92; margin-bottom: 15px;"></i>
                    <h3 style="font-family: 'Montserrat', sans-serif; font-weight: 600; color: #3a3a3a; margin-bottom: 15px; font-size: 1.1rem;">Text Message</h3>
                    <a href="sms:+16462298158?body=Hello!%20I'd%20like%20more%20information%20about%20the%20Signature%20Journey." class="request-btn" style="background: #4A9A92; color: white; padding: 12px 24px; border-radius: 6px; text-decoration: none; font-family: 'Montserrat', sans-serif; font-weight: 600; display: inline-block; transition: all 0.3s ease;">Send a Text</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        // REQUEST MODAL FUNCTIONS
        function openRequestModal() {
            document.getElementById('requestModal').style.display = 'block';
            document.body.style.overflow = 'hidden';
        }
        
        function closeRequestModal() {
            document.getElementById('requestModal').style.display = 'none';
            document.body.style.overflow = 'auto';
        }
        
        window.onclick = function(event) {
            const modal = document.getElementById('requestModal');
            if (event.target == modal) {
                closeRequestModal();
            }
        }
    </script>

</body>
</html>
