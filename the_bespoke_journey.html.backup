    <!-- REQUEST SPOT MODAL -->
    <div id="requestModal" class="request-modal">
        <div class="request-modal-content">
            <span class="request-modal-close" onclick="closeRequestModal()">&times;</span>
            <h2></h2>
            
            <div class="request-contact-options">
                <div class="request-option">
                    <i class="fas fa-envelope"></i>
                    <h3>Email Jessica</h3>
                    <a href="mailto:info@toccaamalfi.com?subject=More%20information%20-%20Bespoke%20Journey" class="request-btn">Send an Email</a>
                </div>
                
                <div class="request-option">
                    <i class="fas fa-phone"></i>
                    <h3>Request a Call</h3>
                    <a href="tel:+16462298158" class="request-btn">Schedule a Call</a>
                </div>
                
                <div class="request-option">
                    <i class="fab fa-whatsapp"></i>
                    <h3>WhatsApp</h3>
                    <a href="https://wa.me/16462298158?text=Hello!%20I'd%20like%20to%20inquire%20about%20the%20Bespoke%20Journey." target="_blank" class="request-btn">Send a Message</a>
                </div>
                
                <div class="request-option">
                    <i class="fas fa-comment"></i>
                    <h3>Text Message</h3>
                    <a href="sms:+16462298158?body=Hello!%20I'd%20like%20to%20inquire%20about%20the%20Bespoke%20Journey." class="request-btn">Send a Text</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        // HAMBURGER MENU
        document.addEventListener('DOMContentLoaded', function() {
            const hamburger = document.querySelector(".hamburger");
            const navMenu = document.querySelector(".nav-menu");
            const navLinks = document.querySelectorAll(".nav-link");
            
            if (hamburger && navMenu) {
                hamburger.addEventListener("click", function(e) {
                    e.preventDefault();
                    hamburger.classList.toggle("active");
                    navMenu.classList.toggle("active");
                    document.body.classList.toggle("no-scroll");
                });

                navLinks.forEach(function(link) {
                    link.addEventListener("click", function() {
                        hamburger.classList.remove("active");
                        navMenu.classList.remove("active");
                        document.body.classList.remove("no-scroll");
                    });
                });

                document.addEventListener("click", function(e) {
                    const isClickInsideMenu = navMenu.contains(e.target);
                    const isClickOnHamburger = hamburger.contains(e.target);
                    
                    if (!isClickInsideMenu && !isClickOnHamburger && navMenu.classList.contains('active')) {
                        hamburger.classList.remove("active");
                        navMenu.classList.remove("active");
                        document.body.classList.remove("no-scroll");
                    }
                });
            }
        });

        // REQUEST MODAL FUNCTIONS
        function openRequestModal() {
            document.getElementById('requestModal').style.display = 'block';
            document.body.style.overflow = 'hidden';
        }
        
        function closeRequestModal() {
            document.getElementById('requestModal').style.display = 'none';
            document.body.style.overflow = 'auto';
        }
        
        window.onclick = function(event) {
            const modal = document.getElementById('requestModal');
            if (event.target == modal) {
                closeRequestModal();
            }
        }

        // CONTACT MENU TOGGLE
        let contactMenuOpen = false;
        function toggleContactMenu() {
            const menu = document.getElementById('contact-menu');
            menu.classList.toggle('active');
            contactMenuOpen = !contactMenuOpen;
        }
        document.addEventListener('click', function(event) {
            const menu = document.getElementById('contact-menu');
            if (menu && !menu.contains(event.target) && contactMenuOpen) {
                toggleContactMenu();
            }
        });

        // BESPOKE CAROUSEL FUNCTIONALITY
        let bespokeSlideIndex = 1;
        showBespokeSlides(bespokeSlideIndex);

        function moveBespokeCarousel(n) {
            showBespokeSlides(bespokeSlideIndex += n);
        }

        function currentBespokeSlide(n) {
            showBespokeSlides(bespokeSlideIndex = n);
        }

        function showBespokeSlides(n) {
            let slides = document.querySelectorAll('.bespoke-intro-section .carousel-slide');
            let dots = document.querySelectorAll('.bespoke-intro-section .dot');
            
            if (n > slides.length) { bespokeSlideIndex = 1 }
            if (n < 1) { bespokeSlideIndex = slides.length }
            
            for (let i = 0; i < slides.length; i++) {
                slides[i].classList.remove("active");
            }
            for (let i = 0; i < dots.length; i++) {
                dots[i].classList.remove("active");
            }
            
            slides[bespokeSlideIndex - 1].classList.add("active");
            dots[bespokeSlideIndex - 1].classList.add("active");
        }

        // Auto-advance bespoke carousel every 5 seconds
        setInterval(() => {
            moveBespokeCarousel(1);
        }, 5000);

        // BACK TO TOP BUTTON
        const backToTopBtn = document.getElementById('backToTop');
        
        window.addEventListener('scroll', function() {
            if (window.pageYOffset > 300) {
                backToTopBtn.classList.add('show');
            } else {
                backToTopBtn.classList.remove('show');
            }
        });
        
        backToTopBtn.addEventListener('click', function() {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });
    </script>
</body>

</html>